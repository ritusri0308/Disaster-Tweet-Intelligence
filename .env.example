# CrisisLens Environment Configuration
# Copy to .env and adjust. Every variable is optional.

# --- Locations (defaults: data/, models/, reports/ inside the project) ---
# Redirecting these is how the test suite keeps production artifacts safe.
CRISISLENS_DATA_DIR=
CRISISLENS_MODELS_DIR=
CRISISLENS_REPORTS_DIR=

# --- API ---
# When set, /analyze, /analyze/batch, /feedback, /surges and /incidents require an `X-API-Key` header.
CRISISLENS_API_KEY=
# Comma-separated browser origins allowed to call the API, e.g. https://dashboard.example.org
CRISISLENS_CORS_ORIGINS=

# --- Safety ---
# Allow the pipeline to generate synthetic demo data when no HumAID TSV files exist (same as --demo).
CRISISLENS_ALLOW_SYNTHETIC=
# A model with fewer vocabulary terms than this is reported as "degraded" (default 1000).
CRISISLENS_MIN_VOCAB=
